rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function member(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    match /users/{userId} {
      allow read: if owner(userId);
      allow write: if false;
      match /{document=**} {
        allow read: if owner(userId);
        allow write: if false;
      }
    }
    match /groups/{groupId} {
      allow read: if member(groupId);
      allow write: if false;
      match /{document=**} {
        allow read: if member(groupId);
        allow write: if false;
      }
    }
  }
}
